#!/usr/bin/env bash
###################################################################
# Script Name : bigclock
# Description : A clock in block characters, scaled to fill the terminal
# Args : [options]
# Author : Barnabás Vass
###################################################################
#
# No dependencies and nothing forked once a second: the time comes from printf's
# %(...)T and the tick from read, so this costs nothing to leave running. The
# terminal size is read at the start and again on a resize, not every tick.

usage() {
    cat <<EOF
Usage: ${0##*/} [options]

Shows the time in block characters, as large as the terminal allows. Press any
key to quit.

Options:
  -b, --block CHAR   Character the digits are drawn with (default: a full block)
  -c, --colour NAME  Colour: a name (red, green, yellow, blue, magenta, cyan,
                     white) or a 0-255 colour number
  -s, --scale N      Fixed scale: rows per font pixel, the width follows from
                     the aspect so the digits keep their shape
  -f, --fill AMOUNT  How much of the terminal the clock may take, as a
                     percentage or a fraction: 80 and 0.8 mean the same thing,
                     and the rest is left as a border (default: 100, all of it)
  -a, --aspect N     Columns per row of a terminal cell, which is how the digits
                     are kept from looking stretched (default: 2)
  -m, --no-seconds   Show HH:MM only, which leaves room for larger digits
  -S, --stack        Put the seconds on a second line, under HH:MM, which fits
                     the shape of a window far better than one long line
  -d, --date         Show the date under the clock (the default)
  -D, --no-date      Leave the date out, giving the digits the whole window
  -1, --once         Draw one frame and exit, without hiding the cursor
  -h, --help         Show this help

Examples:
  ${0##*/}                   # fills the window, ticks every second
  ${0##*/} -m -c cyan        # hours and minutes, in cyan
  ${0##*/} -S                # HH:MM with the seconds underneath, the largest fit
  ${0##*/} -f 0.8            # leave a border of a tenth of the window each side
  ${0##*/} -f 0.5            # half the window, a wide border around it
  ${0##*/} -D                # no date line, just the time

Environment:
  BIGCLOCK_FILL, BIGCLOCK_ASPECT, BIGCLOCK_BLOCK and BIGCLOCK_COLOUR set the
  defaults, so a preference can be exported once instead of typed every time,
  and BIGCLOCK_DATE=0 turns the date line off. An option on the command line
  still wins.
  ${0##*/} --block '#' -s 3  # ASCII only, three rows per font pixel
EOF
}

# Five rows of three pixels per character. Everything else is drawn blank.
declare -A GLYPH=(
    [0]='111 101 101 101 111' [1]='010 010 010 010 010'
    [2]='111 001 111 100 111' [3]='111 001 111 001 111'
    [4]='101 101 111 001 001' [5]='111 100 111 001 111'
    [6]='111 100 111 101 111' [7]='111 001 001 001 001'
    [8]='111 101 111 101 111' [9]='111 101 111 001 111'
    [':']='000 010 000 010 000'
)
declare -A COLOUR=(
    [red]=1 [green]=2 [yellow]=3 [blue]=4 [magenta]=5 [cyan]=6 [white]=7
)

# Turn a fraction into a percentage, so the padding can be given either way:
# 0.8 and 80 both mean four fifths. Bash has no floating point, so the first two
# digits of the fraction are the percentage.
# Args: a percentage or a fraction
percentage() {
    local value=$1 whole frac
    case $value in
        *.*)
            whole=${value%%.*}
            frac=${value#*.}0
            frac=${frac:0:2}
            if [[ ${whole:-0} =~ ^[0-9]+$ && $frac =~ ^[0-9]+$ ]]; then
                printf '%s\n' "$((${whole:-0} * 100 + 10#$frac))"
            else
                printf '%s\n' "$value" # not a number: rejected by the check below
            fi
            ;;
        *) printf '%s\n' "$value" ;;
    esac
}

block=${BIGCLOCK_BLOCK:-$'\u2588'}
colour=${BIGCLOCK_COLOUR:-}
scale=0
fill=$(percentage "${BIGCLOCK_FILL:-100}")
aspect=${BIGCLOCK_ASPECT:-2}
seconds=1
stack=0
show_date=1
case ${BIGCLOCK_DATE:-1} in
    0 | no | off | false) show_date=0 ;;
esac
once=0

while (($# > 0)); do
    case $1 in
        -b | --block)
            block=$2
            shift
            ;;
        -c | --colour | --color)
            colour=$2
            shift
            ;;
        -s | --scale)
            scale=$2
            shift
            ;;
        -f | --fill)
            fill=$(percentage "$2")
            shift
            ;;
        -a | --aspect)
            aspect=$2
            shift
            ;;
        -m | --no-seconds) seconds=0 ;;
        -S | --stack) stack=1 ;;
        -d | --date) show_date=1 ;;
        -D | --no-date) show_date=0 ;;
        -1 | --once) once=1 ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            printf '%s: unknown option: %s\n' "${0##*/}" "$1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

if [[ -n $colour ]]; then
    if [[ -n ${COLOUR[$colour]:-} ]]; then
        colour=${COLOUR[$colour]}
    elif [[ ! $colour =~ ^[0-9]+$ ]] || ((colour > 255)); then
        printf '%s: not a colour: %s\n' "${0##*/}" "$colour" >&2
        exit 2
    fi
    colour=$'\033[38;5;'$colour'm'
fi

if [[ ! $scale =~ ^[0-9]+$ ]]; then
    printf '%s: not a scale: %s\n' "${0##*/}" "$scale" >&2
    exit 2
fi

if [[ ! $fill =~ ^[0-9]+$ ]] || ((fill < 10 || fill > 100)); then
    printf '%s: fill must be 10-100 percent, or 0.1-1.0: %s\n' "${0##*/}" "$fill" >&2
    exit 2
fi

if [[ ! $aspect =~ ^[0-9]+$ ]] || ((aspect < 1 || aspect > 6)); then
    printf '%s: aspect must be between 1 and 6: %s\n' "${0##*/}" "$aspect" >&2
    exit 2
fi

# The size of one frame in font pixels: a character is 3 wide and 5 tall, with a
# 1 pixel gap between characters and between the two lines of a stacked clock.
((seconds)) || stack=0
if ((stack)); then
    glyph_count=5 # HH:MM on top, the 2 of SS fit inside that width
    frame_rows=11 # two lines of 5, with a gap between them
elif ((seconds)); then
    glyph_count=8
    frame_rows=5
else
    glyph_count=5
    frame_rows=5
fi
frame_pixels=$((glyph_count * 4 - 1))

term_cols=80
term_lines=24

# Ask the terminal how big it is. COLUMNS and LINES are not exported to a
# script, so this is the only way, and it is done once and on resize rather than
# every tick.
read_terminal_size() {
    local size=''
    # An exported COLUMNS and LINES wins, which is how a size can be forced.
    if [[ -n ${COLUMNS:-} && -n ${LINES:-} ]]; then
        term_cols=$COLUMNS
        term_lines=$LINES
    elif size=$(stty size 2>/dev/null </dev/tty); then
        term_lines=${size%% *}
        term_cols=${size##* }
    else
        term_lines=$(tput lines 2>/dev/null) || term_lines=24
        term_cols=$(tput cols 2>/dev/null) || term_cols=80
    fi
    [[ $term_lines =~ ^[0-9]+$ ]] || term_lines=24
    [[ $term_cols =~ ^[0-9]+$ ]] || term_cols=80
}

# Draw one frame: the time in block characters, centred, with every line padded
# so the frame before it is overwritten. Nothing is cleared between frames,
# which is what keeps it from flickering.
# Args: time string, date string (may be empty)
# Build the rows of one line of characters into BLOCK_ROWS, at the given scale.
# Args: string, horizontal scale, vertical scale
BLOCK_ROWS=()
build_block() {
    local text=$1 w=$2 h=$3
    local i n r row pixels char on off
    local -a bits

    BLOCK_ROWS=()
    printf -v off '%*s' "$w" ''
    on=${off// /$block}

    for ((r = 0; r < 5; r++)); do
        row=''
        for ((i = 0; i < ${#text}; i++)); do
            char=${text:i:1}
            read -r -a bits <<<"${GLYPH[$char]:-000 000 000 000 000}"
            pixels=${bits[r]}
            for ((n = 0; n < 3; n++)); do
                [[ ${pixels:n:1} == 1 ]] && row+=$on || row+=$off
            done
            ((i < ${#text} - 1)) && row+=$off
        done
        for ((n = 0; n < h; n++)); do BLOCK_ROWS+=("$row"); done
    done
}

# Draw one frame: the time in block characters, centred, with every line padded
# so the frame before it is overwritten. Nothing is cleared between frames,
# which is what keeps it from flickering.
# Args: time string, date string (may be empty)
draw_frame() {
    local time=$1 date_line=$2
    local w h n row pad frame='\033[H' width
    local max_cols max_rows top bottom inner
    local -a rows=()

    if ((scale > 0)); then
        h=$scale
    else
        # The box the clock may fill, and the largest whole scale that fits it
        # both ways. A terminal cell is taller than it is wide, so the width of a
        # font pixel is multiplied by the aspect to keep it square; deciding the
        # two scales independently is what made the digits look stretched.
        max_cols=$((term_cols * fill / 100))
        max_rows=$((term_lines * fill / 100 - show_date * 2))
        h=$((max_rows / frame_rows))
        ((h > max_cols / (frame_pixels * aspect))) && h=$((max_cols / (frame_pixels * aspect)))
    fi
    ((h < 1)) && h=1
    w=$((h * aspect))
    width=$((w * frame_pixels))

    if ((stack)); then
        # HH:MM over SS, which is much closer to the shape of a terminal window
        # than one long line, so both directions of the box get filled.
        top=${time%:*}
        bottom=${time##*:}
        build_block "$top" "$w" "$h"
        rows=("${BLOCK_ROWS[@]}")
        printf -v inner '%*s' "$width" ''
        for ((n = 0; n < h; n++)); do rows+=("$inner"); done
        build_block "$bottom" "$w" "$h"
        # The seconds are narrower than the line above, so they are centred in it.
        printf -v pad '%*s' $(((width - ${#BLOCK_ROWS[0]}) / 2)) ''
        for row in "${BLOCK_ROWS[@]}"; do rows+=("$pad$row"); done
    else
        build_block "$time" "$w" "$h"
        rows=("${BLOCK_ROWS[@]}")
    fi

    printf -v pad '%*s' $(((term_cols - width) / 2)) ''
    for ((n = 0; n < (term_lines - ${#rows[@]} - show_date * 2) / 2; n++)); do
        frame+='\033[K\n'
    done
    for row in "${rows[@]}"; do frame+="$pad$row\033[K\n"; done
    if [[ -n $date_line ]]; then
        printf -v pad '%*s' $(((term_cols - ${#date_line}) / 2)) ''
        frame+="\033[K\n$pad$date_line\033[K\n"
    fi
    printf '%b\033[J' "$colour$frame"
}

now=''
today=''
read_terminal_size
# A resize interrupts the read below, so the next frame is drawn at the new size.
trap read_terminal_size WINCH

if ((once)); then
    printf -v now '%(%H:%M:%S)T' -1
    ((seconds)) || now=${now%:*}
    ((show_date)) && printf -v today '%(%A, %F)T' -1
    draw_frame "$now" "$today"
    [[ -n $colour ]] && printf '\033[0m'
    exit 0
fi

if [[ ! -t 1 ]]; then
    printf '%s: needs a terminal\n' "${0##*/}" >&2
    exit 1
fi

printf '\033[?25l' # hide the cursor
# Restore the terminal however this ends: a keypress, a signal, or a hangup.
trap 'printf "\033[0m\033[?25h\033[2J\033[H"; exit 0' EXIT INT TERM HUP

while :; do
    printf -v now '%(%H:%M:%S)T' -1
    ((seconds)) || now=${now%:*}
    ((show_date)) && printf -v today '%(%A, %F)T' -1
    draw_frame "$now" "$today"

    # A keypress quits. Without a terminal on stdin read would see EOF and
    # return at once, so the second is waited out by sleep instead.
    if [[ -t 0 ]]; then
        read -rsn1 -t 1 && exit 0
    else
        sleep 1
    fi
done
